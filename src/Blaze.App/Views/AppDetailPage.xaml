<Page x:Class="Blaze.App.Views.AppDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="App Details"
      Background="{StaticResource BackgroundDarkestBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Back Button -->
            <Button Grid.Row="0"
                    Content="Back to Store"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16"
                    Click="BackButton_Click"/>

            <!-- Header Section -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon -->
                <Border Grid.Column="0"
                        Width="180" Height="180"
                        Background="{StaticResource BackgroundMediumBrush}"
                        CornerRadius="8">
                    <Grid>
                        <Image Source="{Binding App.IconUrl}"
                               Stretch="UniformToFill"
                               Visibility="{Binding App.IconUrl, Converter={StaticResource PathToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding App.Name, Converter={StaticResource FirstLetterConverter}}"
                                   FontSize="72"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding App.IconUrl, Converter={StaticResource InversePathToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- App Info -->
                <StackPanel Grid.Column="1" Margin="24,0">
                    <TextBlock Text="{Binding App.Name}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="{Binding App.Developer}"
                               Foreground="{StaticResource AccentSecondaryBrush}"
                               FontSize="16"
                               Margin="0,4,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding App.Rating, StringFormat={}{0:F1}}"
                                   Foreground="{StaticResource AccentSecondaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text=" / 5 stars"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,2"/>
                        <TextBlock Text=" • "
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Bottom"
                                   Margin="8,0,0,2"/>
                        <TextBlock Text="{Binding App.ReviewCount, StringFormat='{}{0:N0} reviews'}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,2"/>
                    </StackPanel>

                    <WrapPanel Margin="0,12,0,0">
                        <Border Background="{StaticResource BackgroundMediumBrush}"
                                CornerRadius="4"
                                Padding="12,6"
                                Margin="0,0,8,8">
                            <TextBlock Text="{Binding App.SizeFormatted}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"/>
                        </Border>
                        <Border Background="{StaticResource BackgroundMediumBrush}"
                                CornerRadius="4"
                                Padding="12,6"
                                Margin="0,0,8,8">
                            <TextBlock Text="{Binding App.Version, StringFormat='v{0}'}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"/>
                        </Border>
                        <Border Background="{StaticResource BackgroundMediumBrush}"
                                CornerRadius="4"
                                Padding="12,6"
                                Margin="0,0,8,8">
                            <TextBlock Text="{Binding App.LicenseType}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <!-- Price -->
                    <TextBlock Text="Free"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Version Info (shown when installed) -->
                    <StackPanel x:Name="VersionInfoPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock x:Name="InstalledVersionText"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="UpdateAvailableText"
                                   Text="New version available!"
                                   Foreground="{StaticResource AccentSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Install Button (not installed) -->
                    <Button x:Name="InstallButton"
                            Content="Install"
                            Style="{StaticResource InstallButtonStyle}"
                            Width="200"
                            Click="Install_Click"/>

                    <!-- Launch Button (installed, no update) -->
                    <Button x:Name="LaunchButton"
                            Content="Launch"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="200"
                            Visibility="Collapsed"
                            Click="Launch_Click"/>

                    <!-- Update Button (installed with update available) -->
                    <Button x:Name="UpdateButton"
                            Content="Update"
                            Style="{StaticResource InstallButtonStyle}"
                            Width="200"
                            Visibility="Collapsed"
                            Click="Update_Click"/>

                    <!-- Download Progress -->
                    <StackPanel x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock x:Name="DownloadStatusText"
                                   Text="Downloading..."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="3"
                                Height="6"
                                Width="200"
                                Margin="0,8,0,0">
                            <Border x:Name="DownloadProgressBar"
                                    Background="{StaticResource AccentPrimaryBrush}"
                                    CornerRadius="3"
                                    Height="6"
                                    HorizontalAlignment="Left"
                                    Width="0"/>
                        </Border>
                    </StackPanel>

                    <!-- Secondary Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="LaunchSmallButton"
                                Content="Launch"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="Launch_Click"/>
                        <Button x:Name="WishlistButton"
                                Content="Wishlist"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Click="ToggleWishlist_Click"/>
                        <Button x:Name="UninstallButton"
                                Content="Uninstall"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8"
                                Visibility="Collapsed"
                                Click="Uninstall_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Description Section -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="4"
                    Padding="24"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="About this app"
                               Style="{StaticResource SubheaderStyle}"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding App.Description}"
                               Style="{StaticResource BodyStyle}"
                               TextWrapping="Wrap"/>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,24"/>

                    <!-- Details Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Developer"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding App.Developer}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Publisher"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding App.Publisher}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="Release Date"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding App.ReleaseDate, StringFormat='{}{0:MMMM d, yyyy}'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="Last Updated"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding App.LastUpdated, StringFormat='{}{0:MMMM d, yyyy}'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,16">
                            <TextBlock Text="Total Downloads"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding App.DownloadCount, StringFormat='{}{0:N0}'}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,0,0,16">
                            <TextBlock Text="Minimum OS"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding App.MinimumOsVersion}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="3">
                            <TextBlock Text="Website"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding App.Website}"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="Website_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Similar Apps Section -->
            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="4"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Similar Apps"
                               Style="{StaticResource SubheaderStyle}"
                               Margin="0,0,0,16"/>

                    <ItemsControl x:Name="SimilarAppsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AppCardStyle}"
                                        Width="200"
                                        MouseLeftButtonDown="SimilarApp_Click"
                                        Tag="{Binding Id}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Background="{StaticResource BackgroundMediumBrush}"
                                                CornerRadius="4,4,0,0">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding IconUrl, Converter={StaticResource PathToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Name, Converter={StaticResource FirstLetterConverter}}"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IconUrl, Converter={StaticResource InversePathToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="12,12,12,4"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Developer}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   Margin="12,0,12,12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
