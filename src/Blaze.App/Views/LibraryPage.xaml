<Page x:Class="Blaze.App.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Library"
      Background="{StaticResource BackgroundDarkestBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundDarkBrush}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="My Library"
                           Style="{StaticResource HeaderStyle}"
                           VerticalAlignment="Center"/>

                <!-- Search -->
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Margin="24,0"
                         MaxWidth="400"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Filter -->
                <ComboBox Grid.Column="2"
                          x:Name="FilterComboBox"
                          Style="{StaticResource BlazeComboBoxStyle}"
                          Width="130"
                          Margin="0,0,8,0"
                          SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Installed"/>
                    <ComboBoxItem Content="Has Updates"/>
                    <ComboBoxItem Content="Favorites"/>
                </ComboBox>

                <!-- Sort -->
                <ComboBox Grid.Column="3"
                          x:Name="SortComboBox"
                          Style="{StaticResource BlazeComboBoxStyle}"
                          Width="150"
                          Margin="0,0,8,0"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="Name" IsSelected="True"/>
                    <ComboBoxItem Content="Recently Played"/>
                    <ComboBoxItem Content="Install Date"/>
                    <ComboBoxItem Content="Size"/>
                    <ComboBoxItem Content="Play Time"/>
                </ComboBox>

                <!-- View Toggle -->
                <Button Grid.Column="4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,8"
                        Click="ToggleView_Click">
                    <TextBlock x:Name="ViewToggleText" Text="List View"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- Empty State -->
                <StackPanel x:Name="EmptyState"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Margin="0,100">
                    <TextBlock Text="No apps installed yet"
                               Style="{StaticResource SubheaderStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Browse the store to find and install apps"
                               Style="{StaticResource BodyStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,24"/>
                    <Button Content="Browse Store"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BrowseStore_Click"/>
                </StackPanel>

                <!-- Grid View -->
                <ItemsControl x:Name="AppsGridView">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AppCardStyle}"
                                    Width="280">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- App Header -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource BackgroundMediumBrush}"
                                            CornerRadius="4,4,0,0">
                                        <Grid>
                                            <!-- Icon Image (shown when IconPath exists) -->
                                            <Image Source="{Binding IconPath}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding IconPath, Converter={StaticResource PathToVisibilityConverter}}"/>
                                            <!-- Fallback: First Letter (shown when no icon) -->
                                            <TextBlock Text="{Binding Name, Converter={StaticResource FirstLetterConverter}}"
                                                       FontSize="36"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IconPath, Converter={StaticResource InversePathToVisibilityConverter}}"/>

                                            <!-- Running Indicator -->
                                            <Border Background="{StaticResource SuccessBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="8"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Running" FontSize="10" Foreground="White"/>
                                            </Border>

                                            <!-- Update Available -->
                                            <Border Background="{StaticResource AccentPrimaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="8"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Update" FontSize="10" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- App Name -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="12,12,12,4"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Info -->
                                    <StackPanel Grid.Row="2" Margin="12,0,12,8">
                                        <TextBlock Text="{Binding InstalledVersion, StringFormat='v{0}'}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding TotalPlayTimeFormatted}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                Margin="12,0,12,12">
                                        <Button Content="Launch"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="16,8"
                                                Click="LaunchApp_Click"
                                                Tag="{Binding ApplicationId}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <Button Content="Stop"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="16,8"
                                                Click="StopApp_Click"
                                                Tag="{Binding ApplicationId}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Button Content="..."
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,8"
                                                Margin="8,0,0,0"
                                                Click="ShowAppMenu_Click"
                                                Tag="{Binding ApplicationId}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- List View -->
                <ItemsControl x:Name="AppsListView" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="4"
                                    Margin="0,4"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            Background="{StaticResource BackgroundMediumBrush}"
                                            CornerRadius="4">
                                        <Grid>
                                            <Image Source="{Binding IconPath}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding IconPath, Converter={StaticResource PathToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource FirstLetterConverter}}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IconPath, Converter={StaticResource InversePathToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="16,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                                            <Run Text="{Binding InstalledVersion, StringFormat='v{0}'}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding InstalledSizeFormatted}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Play Time -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotalPlayTimeFormatted}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="16,0"/>

                                    <!-- Status -->
                                    <Border Grid.Column="3"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{StaticResource SuccessBrush}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="8,0">
                                        <TextBlock Text="Running" FontSize="11" Foreground="White"/>
                                    </Border>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button Content="Launch"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="16,8"
                                                Click="LaunchApp_Click"
                                                Tag="{Binding ApplicationId}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
