<Window x:Class="Blaze.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Blaze - Sign In"
        Height="550" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{StaticResource BackgroundDarkBrush}"
            CornerRadius="8"
            BorderBrush="{StaticResource BorderDarkBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundDarkestBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="BLAZE"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}"/>
                    </StackPanel>
                    <Button Content="X"
                            HorizontalAlignment="Right"
                            Width="30" Height="30"
                            Background="Transparent"
                            Foreground="{StaticResource TextMutedBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="32,24">
                <!-- Login Panel -->
                <StackPanel x:Name="LoginPanel"
                            Visibility="{Binding IsRegisterMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <TextBlock Text="Welcome Back"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Sign in to access your apps and downloads"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32"/>

                    <!-- Username -->
                    <TextBlock Text="USERNAME"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="LoginUsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,16"/>

                    <!-- Password -->
                    <TextBlock Text="PASSWORD"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Margin="0,0,0,16"
                                 PasswordChanged="LoginPasswordBox_PasswordChanged"/>

                    <!-- Remember Me -->
                    <CheckBox Content="Remember me"
                              IsChecked="{Binding RememberMe}"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Margin="0,0,0,24"/>

                    <!-- Error Message -->
                    <Border Background="#33cd3737"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                    </Border>

                    <!-- Sign In Button -->
                    <Button Content="SIGN IN"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            Margin="0,0,0,16"/>

                    <!-- Loading indicator -->
                    <TextBlock Text="Signing in..."
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,0,0,16"/>

                    <!-- Register Link -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <TextBlock Text="Don't have an account? "
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="Create one"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="SwitchToRegister_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Register Panel -->
                <StackPanel x:Name="RegisterPanel"
                            Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="Create Account"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Join Blaze to discover and manage your apps"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Username -->
                    <TextBlock Text="USERNAME"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="RegisterUsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <!-- Email -->
                    <TextBlock Text="EMAIL"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="RegisterEmailBox"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,12"/>

                    <!-- Password -->
                    <TextBlock Text="PASSWORD"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="RegisterPasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Margin="0,0,0,12"
                                 PasswordChanged="RegisterPasswordBox_PasswordChanged"/>

                    <!-- Confirm Password -->
                    <TextBlock Text="CONFIRM PASSWORD"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Margin="0,0,0,16"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                    <!-- Error Message -->
                    <Border Background="#33cd3737"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                    </Border>

                    <!-- Register Button -->
                    <Button Content="CREATE ACCOUNT"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            Margin="0,0,0,12"/>

                    <!-- Loading indicator -->
                    <TextBlock Text="Creating account..."
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,0,0,12"/>

                    <!-- Login Link -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Already have an account? "
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="Sign in"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="SwitchToLogin_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
