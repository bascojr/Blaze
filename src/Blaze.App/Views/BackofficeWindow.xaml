<Window x:Class="Blaze.App.Views.BackofficeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Blaze - Backoffice Administration"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDarkestBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BLAZE"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}"/>
                    <TextBlock Text=" BACKOFFICE"
                               FontSize="22"
                               FontWeight="Light"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="4,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Close"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CloseCommand}"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Application List -->
            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundDarkBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <Border Grid.Row="0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Applications"
                                       Style="{StaticResource SubheaderStyle}"/>

                            <Button Grid.Column="1"
                                    Content="+ New"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="16,8"
                                    Command="{Binding NewApplicationCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Application List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Applications}"
                             SelectedItem="{Binding SelectedApplication}"
                             Style="{StaticResource AppListBoxStyle}"
                             Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="4"
                                        Margin="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="80"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- App Header with Icon or First Letter -->
                                        <Border Grid.Row="0"
                                                Background="{StaticResource BackgroundMediumBrush}"
                                                CornerRadius="4,4,0,0">
                                            <Grid>
                                                <Image Source="{Binding IconUrl}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding IconUrl, Converter={StaticResource PathToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Name, Converter={StaticResource FirstLetterConverter}}"
                                                           FontSize="36"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IconUrl, Converter={StaticResource InversePathToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- App Name -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="10,10,10,2"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Developer -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Developer}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="10,0,10,2"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Rating and Price -->
                                        <Grid Grid.Row="3" Margin="10,2,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}"
                                                           Foreground="{StaticResource AccentSecondaryBrush}"
                                                           FontSize="11"/>
                                                <TextBlock Text=" / 5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding IsFree, Converter={StaticResource BoolToFreeTextConverter}}"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Panel - Edit Form -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Form Title -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding FormTitle}"
                               Style="{StaticResource HeaderStyle}"
                               Margin="0,0,0,24"/>

                    <!-- Form Content -->
                    <StackPanel Grid.Row="1">

                        <!-- Basic Info Section -->
                        <TextBlock Text="BASIC INFORMATION"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- App Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Application Name *"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Version -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Version"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Developer -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Developer *"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Developer, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Publisher -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Publisher"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Price -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Price (0 for free)"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Category"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedValue="{Binding CategoryId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource BlazeComboBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Short Description -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Short Description"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     MaxLength="150"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Full Description *"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="120"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- Tags -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="Tags (comma-separated)"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Files Section -->
                        <TextBlock Text="FILES"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Package File -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Package File (ZIP/Installer) *"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding PackageFilePath}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         IsReadOnly="True"/>
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Padding="16,10"
                                        Command="{Binding BrowsePackageCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Executable Path -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Executable Path (relative to install folder)"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <!-- Icon File -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Application Icon"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding IconFilePath}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         IsReadOnly="True"/>
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Padding="16,10"
                                        Command="{Binding BrowseIconCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Screenshots -->
                        <StackPanel Margin="0,0,0,24">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Screenshots"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                                <Button Grid.Column="1"
                                        Content="+ Add Screenshots"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Command="{Binding BrowseScreenshotsCommand}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ScreenshotPaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="4"
                                                Padding="8"
                                                Margin="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="X"
                                                        Background="Transparent"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.RemoveScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Technical Details Section -->
                        <TextBlock Text="TECHNICAL DETAILS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Minimum OS -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Minimum OS Version"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MinimumOsVersion, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Architecture -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Supported Architectures"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SupportedArchitectures, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Website -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="Website"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Support Email -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="Support Email"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SupportEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- License and Admin -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="License Type"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LicenseType, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <CheckBox Content="Requires Admin Privileges"
                                          IsChecked="{Binding RequiresAdmin}"
                                          Style="{StaticResource BlazeCheckBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Error Message -->
                        <Border Background="#33cd3737"
                                CornerRadius="4"
                                Padding="12,8"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Status Message -->
                        <Border Background="#335ba32b"
                                CornerRadius="4"
                                Padding="12,8"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Delete Application"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{StaticResource ErrorBrush}"
                                    Command="{Binding DeleteCommand}"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Button Grid.Column="2"
                                    Content="{Binding IsEditMode, Converter={StaticResource BoolToSaveTextConverter}}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="180"
                                    Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                        </Grid>

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <TextBlock Text="{Binding Applications.Count, StringFormat='Total Applications: {0}'}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Saving..."
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
