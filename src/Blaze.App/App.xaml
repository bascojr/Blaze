<Application x:Class="Blaze.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Blaze.App.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:RatingToStarsConverter x:Key="RatingToStarsConverter"/>
            <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
            <converters:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:StringToColorConverter x:Key="StringToColorConverter"/>
            <converters:RelativeDateConverter x:Key="RelativeDateConverter"/>
            <converters:BoolToFreeTextConverter x:Key="BoolToFreeTextConverter"/>
            <converters:FirstLetterConverter x:Key="FirstLetterConverter"/>
            <converters:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
            <converters:IntToIndexConverter x:Key="IntToIndexConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
